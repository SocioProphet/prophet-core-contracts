{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/contracts/release-manifest/v0.1.schema.json",
  "title": "ContractReleaseManifest",
  "description": "Machine-readable manifest for a prophet-core-contracts release tag.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_tag",
    "release_commit",
    "released_at",
    "release_status",
    "repo",
    "contracts_included",
    "schemas",
    "validators",
    "canonicalization_profiles",
    "changelog_ref",
    "compatibility",
    "validation"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "release_tag": {"type": "string", "pattern": "^contracts-v[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$"},
    "release_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "released_at": {"type": "string", "format": "date-time"},
    "release_status": {"type": "string", "enum": ["rc", "stable", "superseded", "withdrawn"]},
    "repo": {"type": "string", "const": "SocioProphet/prophet-core-contracts"},
    "contracts_included": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contract_entry"}
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_entry"}
    },
    "validators": {
      "type": "array",
      "items": {"$ref": "#/$defs/file_entry"}
    },
    "canonicalization_profiles": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "changelog_ref": {"type": "string", "minLength": 1},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semver_policy", "breaking_change_policy", "tag_immutability"],
      "properties": {
        "semver_policy": {"type": "string", "const": "pre-1.0-semver"},
        "breaking_change_policy": {"type": "string", "minLength": 1},
        "tag_immutability": {"type": "boolean", "const": true}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["make_validate_passed", "validated_at", "validator_command"],
      "properties": {
        "make_validate_passed": {"type": "boolean", "const": true},
        "validated_at": {"type": "string", "format": "date-time"},
        "validator_command": {"type": "string", "const": "make validate"}
      }
    }
  },
  "$defs": {
    "contract_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^0\\.1\\.[0-9]+$"},
        "status": {"type": "string", "enum": ["included", "experimental", "deprecated"]}
      }
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
