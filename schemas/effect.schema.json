      "type": "string"
    },
    "requesting_actor_id": {
      "type": "string"
    },
    "resource_ref": {
      "type": "string"
    },
    "rollback_of_effect_ref": {
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "subject_actor_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "effect_id",
    "admission_token_id",
    "action_type",
    "resource_ref",
    "requesting_actor_id",
    "subject_actor_id",
    "attempted_at",
