{
  "$id": "https://prophet-core-contracts.socioprophet.ai/schemas/effect/0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Effect v0.1 stub \u2014 static record-shape for admission chain integration fixtures.",
  "properties": {
    "action_type": {
      "type": "string"
    },
    "admission_token_id": {
      "type": "string"
    },
    "attempted_at": {
      "format": "date-time",
      "type": "string"
    },
    "effect_id": {
      "type": "string"
    },
    "error_ref": {
      "type": "string"
    },
