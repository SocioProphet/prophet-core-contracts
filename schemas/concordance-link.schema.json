{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/prophet/concordance-link.v0.1.schema.json",
  "title": "ConcordanceLink",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_system",
    "source_native_id",
    "source_record_id",
    "canonical_entity_id",
    "resolver_run_id",
    "policy_id",
    "confidence",
    "status",
    "decision_ledger_id"
  ],
  "properties": {
    "source_system": { "type": "string", "minLength": 1 },
    "source_native_id": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string", "minLength": 1 },
    "canonical_entity_id": { "type": "string", "minLength": 1 },
    "resolver_run_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "PENDING_REVIEW", "REJECTED", "SUPERSEDED"]
    },
    "decision_ledger_id": { "type": "string", "minLength": 1 },
    "valid_from": { "type": ["string", "null"], "format": "date-time" },
    "valid_to": { "type": ["string", "null"], "format": "date-time" },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "notes": { "type": ["string", "null"] }
  }
}
