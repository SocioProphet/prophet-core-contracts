{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.ai/contracts/evidence-thread.schema.json",
  "title": "EvidenceThread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thread_id",
    "claim_id",
    "evidence_items",
    "created_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "thread_id": { "type": "string", "pattern": "^thread_[a-z0-9][a-z0-9_.-]*$" },
    "claim_id": { "type": "string", "minLength": 1 },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_type"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "evidence_type": {
            "type": "string",
            "enum": [
              "action_receipt",
              "policy_result",
              "workspace_operation",
              "scoped_capability",
              "source_document",
              "observation",
              "claim",
              "artifact",
              "telemetry_receipt"
            ]
          },
          "uri": { "type": "string" },
          "hash": { "type": "string" },
          "supports": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
