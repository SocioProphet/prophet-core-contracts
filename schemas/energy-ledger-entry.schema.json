{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/prophet/energy-ledger-entry.v0.1.schema.json",
  "title": "EnergyLedgerEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_artifact_id",
    "extraction_run_id",
    "policy_id",
    "candidate_set_id",
    "top_entity_id",
    "top_score",
    "runnerup_entity_id",
    "runnerup_score",
    "margin_delta",
    "perturbation_flip_rate",
    "promotion_decision",
    "decision_reason_codes"
  ],
  "properties": {
    "source_artifact_id": { "type": "string", "minLength": 1 },
    "doc_id": { "type": ["string", "null"] },
    "extraction_run_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "candidate_set_id": { "type": "string", "minLength": 1 },
    "top_entity_id": { "type": "string", "minLength": 1 },
    "top_score": { "type": "number" },
    "runnerup_entity_id": { "type": "string", "minLength": 1 },
    "runnerup_score": { "type": "number" },
    "margin_delta": { "type": "number" },
    "perturbation_flip_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "promotion_decision": {
      "type": "string",
      "enum": ["REJECT", "REVIEW", "INSERT_EVIDENCE_ONLY", "PROMOTE_CANONICAL"]
    },
    "decision_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "provenance_offsets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "start", "end"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "label": { "type": ["string", "null"] }
        }
      }
    },
    "score_decomposition": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "number" }
    },
    "notes": { "type": ["string", "null"] }
  }
}
