{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/regis/embedding-card.schema.json",
  "title": "EmbeddingCard",
  "type": "object",
  "required": [
    "schema_version",
    "embedding_id",
    "subject_id",
    "subject_type",
    "embedding_family",
    "model_id",
    "model_version",
    "vector_ref",
    "dimension",
    "feature_assertion_refs",
    "evidence_refs",
    "training_domain",
    "inference_domain",
    "domain_gate_state",
    "policy_state",
    "allowed_uses",
    "prohibited_uses",
    "promotion_state",
    "provenance_hash",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "embedding_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "subject_type": {"type": "string"},
    "embedding_family": {"type": "string"},
    "model_id": {"type": "string"},
    "model_version": {"type": "string"},
    "vector_ref": {"type": "object"},
    "dimension": {"type": "integer", "minimum": 1},
    "feature_assertion_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "training_domain": {"type": "string"},
    "inference_domain": {"type": "string"},
    "domain_gate_state": {"type": "string"},
    "consent_scope": {"type": "object"},
    "revocation_state": {"type": "string"},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "stability": {"type": "number", "minimum": 0, "maximum": 1},
    "policy_state": {"type": "string"},
    "allowed_uses": {"type": "array", "items": {"type": "string"}},
    "prohibited_uses": {"type": "array", "items": {"type": "string"}},
    "promotion_state": {"type": "string"},
    "provenance_hash": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
