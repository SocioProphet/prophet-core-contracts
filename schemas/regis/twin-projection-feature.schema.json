{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/regis/twin-projection-feature.schema.json",
  "title": "TwinProjectionFeature",
  "description": "Canonical v0.1 contract for consent-scoped HolographMe projection features consumed by Regis. This object is a governed feature record, not raw twin state and not canonical truth.",
  "type": "object",
  "required": [
    "schema_version",
    "feature_id",
    "projection_id",
    "decision_log_id",
    "twin_id",
    "subject_id",
    "mission_id",
    "recipient_id",
    "policy_id",
    "feature_family",
    "feature_name",
    "feature_value",
    "source_field_path",
    "source_field_decision",
    "source_field_reason",
    "domain_context",
    "consent_scope_snapshot",
    "mission_governance_snapshot",
    "transition_receipt_ref",
    "projection_decision_log_ref",
    "retention_rule",
    "revocation_state",
    "effective_authority_band",
    "policy_state",
    "do_not_learn",
    "do_not_link",
    "raw_twin_payload_present",
    "hash_algorithm",
    "hash_canonicalization",
    "content_hash",
    "lineage_hash",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$",
      "description": "Consumers must reject unknown major versions. Minor versions are additive only when the canonical schema marks them additive."
    },
    "feature_id": {
      "type": "string",
      "pattern": "^tpf_[a-zA-Z0-9_-]+$"
    },
    "projection_id": {
      "type": "string",
      "pattern": "^proj_[a-zA-Z0-9_-]+$"
    },
    "decision_log_id": {
      "type": "string",
      "pattern": "^pdl_[a-zA-Z0-9_-]+$"
    },
    "twin_id": {
      "type": "string",
      "pattern": "^hdt_[a-zA-Z0-9_-]+$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^sub_[a-zA-Z0-9_-]+$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^mission_[a-zA-Z0-9_-]+$"
    },
    "recipient_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "pattern": "^cp_[a-zA-Z0-9_-]+$"
    },
    "feature_family": {
      "type": "string",
      "enum": [
        "capability",
        "credential",
        "preference",
        "constraint",
        "delegation",
        "assessment",
        "proof"
      ],
      "description": "Closed v0.1 enumeration; additions require a minor-version bump."
    },
    "feature_name": {
      "type": "string",
      "minLength": 1
    },
    "feature_value": {
      "description": "Consented value only. Raw twin payloads, denied fields, and forbidden fields are prohibited.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "feature_confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "source_attested",
        "system_verified"
      ],
      "default": "medium"
    },
    "source_field_path": {
      "type": "string",
      "minLength": 1
    },
    "source_field_decision": {
      "type": "string",
      "const": "allow",
      "description": "Denied or forbidden fields must not become TwinProjectionFeature records."
    },
    "source_field_reason": {
      "type": "string",
      "enum": [
        "allowed_by_consent_policy",
        "allowed_by_projection",
        "allowed_by_policy_fabric",
        "purpose_bound_release",
        "field_minimized",
        "authority_sufficient",
        "subject_authorized",
        "policy_exception_admitted"
      ],
      "description": "Closed safe-reason vocabulary. Free text denial/explanation strings are forbidden because they can leak sensitive content."
    },
    "denial_reason_visibility": {
      "type": "string",
      "enum": [
        "safe_reason_only",
        "deny_without_field_existence_disclosure"
      ],
      "default": "safe_reason_only"
    },
    "domain_context": {
      "type": "object",
      "required": [
        "domain_id",
        "source_modality",
        "calibration_state"
      ],
      "additionalProperties": false,
      "properties": {
        "domain_id": {
          "type": "string",
          "enum": [
            "holographme.mission_projection"
          ]
        },
        "source_modality": {
          "type": "string",
          "enum": [
            "structured_human_digital_twin_projection"
          ]
        },
        "calibration_state": {
          "type": "string",
          "enum": [
            "in_domain",
            "cross_domain_review_required"
          ]
        }
      }
    },
    "consent_scope_snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "policy_id",
        "subject_id",
        "recipient_id",
        "purpose",
        "allowed_recipients",
        "allowed_purposes",
        "allowed_fields_digest",
        "forbidden_fields_digest",
        "expires_at",
        "retention_rule",
        "revocation",
        "delegation",
        "audit"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^0\\.1\\.[0-9]+$"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^cp_[a-zA-Z0-9_-]+$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^sub_[a-zA-Z0-9_-]+$"
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "allowed_recipients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowed_fields_digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "forbidden_fields_digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "retention_rule": {
          "type": "string",
          "minLength": 1
        },
        "revocation": {
          "type": "object",
          "required": [
            "revocable",
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "revocable": {
              "type": "boolean"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "contact": {
              "type": "string"
            }
          }
        },
        "delegation": {
          "type": "object",
          "required": [
            "agents_allowed",
            "max_authority_band"
          ],
          "additionalProperties": false,
          "properties": {
            "agents_allowed": {
              "type": "boolean"
            },
            "max_authority_band": {
              "$ref": "#/$defs/authority_band"
            }
          }
        },
        "audit": {
          "type": "object",
          "required": [
            "log_access",
            "emit_receipts",
            "notify_subject"
          ],
          "additionalProperties": false,
          "properties": {
            "log_access": {
              "type": "boolean"
            },
            "emit_receipts": {
              "type": "boolean"
            },
            "notify_subject": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "mission_governance_snapshot": {
      "type": "object",
      "required": [
        "mission_id",
        "authority_band",
        "audit_required",
        "human_approval_required",
        "conformance_tags"
      ],
      "additionalProperties": false,
      "properties": {
        "mission_id": {
          "type": "string",
          "pattern": "^mission_[a-zA-Z0-9_-]+$"
        },
        "authority_band": {
          "$ref": "#/$defs/authority_band"
        },
        "audit_required": {
          "type": "boolean"
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "conformance_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transition_receipt_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "receipt_id",
            "twin_id",
            "action",
            "actor_id",
            "actor_type",
            "timestamp",
            "policy_version",
            "previous_state_hash",
            "new_state_hash",
            "approval_band"
          ],
          "additionalProperties": false,
          "properties": {
            "receipt_id": {
              "type": "string",
              "pattern": "^tr_[a-zA-Z0-9_-]+$"
            },
            "twin_id": {
              "type": "string",
              "pattern": "^hdt_[a-zA-Z0-9_-]+$"
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "actor_type": {
              "type": "string",
              "enum": [
                "subject",
                "agent",
                "operator",
                "system"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "previous_state_hash": {
              "type": "string",
              "pattern": "^sha256:[a-fA-F0-9]{64}$"
            },
            "new_state_hash": {
              "type": "string",
              "pattern": "^sha256:[a-fA-F0-9]{64}$"
            },
            "approval_band": {
              "$ref": "#/$defs/authority_band"
            },
            "rollback_supported": {
              "type": "boolean"
            },
            "rollback_method": {
              "type": "string"
            },
            "replay_hints": {
              "type": "object"
            }
          }
        }
      ]
    },
    "projection_decision_log_ref": {
      "type": "object",
      "required": [
        "schema_version",
        "decision_log_id",
        "projection_id",
        "twin_id",
        "subject_id",
        "mission_id",
        "recipient_id",
        "policy_id",
        "purpose",
        "generated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^0\\.1\\.[0-9]+$"
        },
        "decision_log_id": {
          "type": "string",
          "pattern": "^pdl_[a-zA-Z0-9_-]+$"
        },
        "projection_id": {
          "type": "string",
          "pattern": "^proj_[a-zA-Z0-9_-]+$"
        },
        "twin_id": {
          "type": "string",
          "pattern": "^hdt_[a-zA-Z0-9_-]+$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^sub_[a-zA-Z0-9_-]+$"
        },
        "mission_id": {
          "type": "string",
          "pattern": "^mission_[a-zA-Z0-9_-]+$"
        },
        "recipient_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "pattern": "^cp_[a-zA-Z0-9_-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "retention_rule": {
      "type": "string",
      "minLength": 1
    },
    "revocation_state": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired",
        "unknown"
      ]
    },
    "effective_authority_band": {
      "$ref": "#/$defs/authority_band"
    },
    "policy_state": {
      "type": "string",
      "enum": [
        "allowed",
        "blocked",
        "restricted",
        "review_required"
      ]
    },
    "do_not_learn": {
      "type": "boolean",
      "const": true,
      "description": "v0.1 protection flag: this feature must not be used for model training, embedding generation, memory persistence, or analytics sinks without a future explicit admitted override."
    },
    "do_not_link": {
      "type": "boolean",
      "const": true,
      "description": "v0.1 protection flag: this feature must not be cross-domain linked, alias-merged, or used for similarity-only identity resolution."
    },
    "raw_twin_payload_present": {
      "type": "boolean",
      "const": false
    },
    "hash_algorithm": {
      "type": "string",
      "const": "sha256"
    },
    "hash_canonicalization": {
      "type": "string",
      "const": "canonical_json_v0.1_utf8_nfc_sorted_keys_no_insignificant_ws"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$",
      "description": "SHA-256 over the canonical JSON representation of feature_value."
    },
    "lineage_hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$",
      "description": "SHA-256 over projection_id || decision_log_id || policy_id || schema_version || created_at_canonical."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revocation_state": {
            "enum": [
              "revoked",
              "expired"
            ]
          }
        },
        "required": [
          "revocation_state"
        ]
      },
      "then": {
        "properties": {
          "policy_state": {
            "enum": [
              "blocked",
              "restricted"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_state": {
            "const": "allowed"
          }
        },
        "required": [
          "policy_state"
        ]
      },
      "then": {
        "properties": {
          "revocation_state": {
            "const": "active"
          }
        }
      }
    }
  ],
  "$defs": {
    "authority_band": {
      "type": "string",
      "enum": [
        "observe",
        "recommend",
        "represent",
        "negotiate",
        "commit"
      ],
      "description": "Authority lattice order: observe < recommend < represent < negotiate < commit. Effective authority is the greatest lower bound over upstream authorities."
    }
  }
}
