{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/contracts/pinned-prophet-core-contracts/v0.1.schema.json",
  "title": "PinnedProphetCoreContracts",
  "description": "Downstream pin file recording the exact prophet-core-contracts release tag and commit used by a consumer repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repo",
    "release_tag",
    "release_commit",
    "manifest_path",
    "manifest_sha256",
    "contracts_used",
    "schema_paths",
    "validator_paths",
    "pinned_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "repo": {"type": "string", "const": "SocioProphet/prophet-core-contracts"},
    "release_tag": {"type": "string", "pattern": "^contracts-v[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$"},
    "release_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "manifest_path": {"type": "string", "pattern": "^releases/contracts-v[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?/manifest\\.json$"},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "contracts_used": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "schema_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validator_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "pinned_at": {"type": "string", "format": "date-time"},
    "updated_by": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
